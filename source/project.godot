; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Diabo A4"
config/version="2.0.0"
run/main_scene="uid://dbdx47nsgglcq"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="uid://cprwim2tvu84l"
config/icon="uid://bijbd3t0d6fpq"

[audio]

buses/default_bus_layout="uid://d1t107elk8omc"

[autoload]

Consts="*uid://c3877hb6j1qqh"
BeehaveGlobalMetrics="*uid://c3ktl6ontsdt7"
BeehaveGlobalDebugger="*uid://bl3ma400hpvsh"
SceneLoader="*uid://c1vlf4hvjuhhx"
MousePointing="*uid://5jyfbpretgb6"
PhantomCameraManager="*uid://duq6jhf6unyis"
DialogueManager="*uid://c3rodes2l3gxb"
MusicPlayer="*uid://u3iwlgfqlbwd"
SaveSys="*uid://civ124t3mhsfk"
InputHelper="*uid://cholww48njaeh"
SceneManager="*uid://qqwbbbaurvfj"

[debug]

gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1

[dialogue_manager]

runtime/balloon_path="res://scenes/dialogue_ballon/balloon.tscn"
editor/wrap_long_lines=true

[display]

window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/size/mode.editor_hint=0

[editor_plugins]

enabled=PackedStringArray("res://addons/awesome_scene_manager/plugin.cfg", "res://addons/beehave/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg", "res://addons/input_helper/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "orange",
"res://resources/": "purple",
"res://scenes/": "teal",
"res://scripts/": "pink",
"res://scripts/beehave/": "purple",
"res://scripts/old_beehave/": "purple"
}

[global_group]

monster=""
camera=""
document="The enemies"
player="The group to grab the player node"

